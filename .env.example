# Local database: matches docker-compose.yml
DATABASE_URL="postgresql://nepali_ghar:local_dev_only@localhost:5432/nepali_ghar?schema=public"
DIRECT_URL="postgresql://nepali_ghar:local_dev_only@localhost:5432/nepali_ghar?schema=public"
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Generate your own value: openssl rand -base64 48
AUTH_SECRET=replace-this-with-your-own-random-secret-at-least-32-characters

# Set all three to enable card checkout. Leave blank until configured.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Development prints email links in the server terminal.
# Production: use resend, a verified sender, and your API key.
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM="Nepali Ghar Australia <orders@example.com>"

# Optional AWS S3 or S3 endpoint supporting presigned POST uploads.
# Other providers can still supply HTTPS URLs pasted in admin.
IMAGE_STORAGE_ENDPOINT=
IMAGE_STORAGE_REGION=ap-southeast-2
IMAGE_STORAGE_BUCKET=
IMAGE_STORAGE_ACCESS_KEY_ID=
IMAGE_STORAGE_SECRET_ACCESS_KEY=
IMAGE_PUBLIC_HOST=

# Optional distributed throttling; recommended on multiple server instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Generate a separate random value for the maintenance endpoint.
CRON_SECRET=
SEED_ADMIN_EMAIL=owner@example.com
SEED_ADMIN_PASSWORD=ChangeMe!12345
# Use only if explicitly loading demo data in a production environment:
SEED_DEMO=false
